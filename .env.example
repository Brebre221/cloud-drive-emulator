# JWT
JWT_SECRET=your_secret_key_here
JWT_EXPIRE=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API
API_URL=http://localhost:3000
MOBILE_API_URL=http://YOUR_SERVER_IP:3000
